# Kataloga frontend environment (all values optional)
#
# Data source used by the service layer.
#   mock (default) -> in-memory development data, no backend required.
#   api            -> proposed API adapters (docs/API-CONTRACT.md).
#                     Contract-ready but pending: no backend exists yet, so
#                     API mode cannot complete requests.
VITE_DATA_SOURCE=mock

# Base URL for API requests.
# Empty (default) -> requests go to the same origin the frontend is served from.
VITE_API_BASE_URL=